FROM rust:1-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        build-essential \
        ca-certificates \
        curl \
        file \
        make \
        perl \
        tar \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src

ENTRYPOINT ["crates/sinomo-sandbox/toolchains/bash/build-bash-wasix.sh"]
