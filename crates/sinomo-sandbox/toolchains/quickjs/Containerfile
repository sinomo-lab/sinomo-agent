FROM rust:1-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        file \
        gcc \
        make \
        pkg-config \
        tar \
        xz-utils \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src

ENTRYPOINT ["crates/sinomo-sandbox/toolchains/quickjs/build-qjs-wasi.sh"]
