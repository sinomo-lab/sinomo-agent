# Sinomo sandbox core BusyBox applet set.
#
# This fragment is applied on top of BusyBox allnoconfig. Commands are exposed
# only when the resulting module builds and passes the fidelity suite.
CONFIG_BUSYBOX=y
CONFIG_DESKTOP=n
CONFIG_LONG_OPTS=y
CONFIG_LFS=y
CONFIG_FEATURE_VERBOSE_USAGE=y
CONFIG_SH_IS_ASH=y
# CONFIG_SH_IS_HUSH is not set
CONFIG_SH_IS_NONE=y
# CONFIG_BASH_IS_ASH is not set
# CONFIG_BASH_IS_HUSH is not set
CONFIG_BASH_IS_NONE=y
# CONFIG_SHELL_ASH is not set
CONFIG_ASH=y
CONFIG_HUSH=n
CONFIG_SHELL_HUSH=n
# CONFIG_FEATURE_SH_MATH is not set
# CONFIG_FEATURE_SH_MATH_64 is not set
# CONFIG_FEATURE_SH_STANDALONE is not set
# CONFIG_FEATURE_SH_NOFORK is not set
CONFIG_AWK=y
CONFIG_FEATURE_AWK_LIBM=n
CONFIG_FEATURE_AWK_GNU_EXTENSIONS=n
CONFIG_CAT=y
CONFIG_CP=y
CONFIG_CMP=y
CONFIG_DATE=y
CONFIG_DIFF=y
CONFIG_DIRNAME=y
CONFIG_ECHO=y
CONFIG_ENV=y
CONFIG_FALSE=y
CONFIG_FIND=y
CONFIG_GREP=y
CONFIG_GZIP=y
CONFIG_FEATURE_GZIP_DECOMPRESS=y
CONFIG_HEAD=y
CONFIG_CHMOD=y
CONFIG_LN=y
CONFIG_TAR=y
CONFIG_FEATURE_TAR_CREATE=y
CONFIG_LS=y
CONFIG_MKDIR=y
CONFIG_MV=y
CONFIG_PATCH=y
CONFIG_PRINTF=y
CONFIG_PWD=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_SED=y
CONFIG_SHA256SUM=y
CONFIG_SLEEP=y
CONFIG_SORT=y
CONFIG_TAIL=y
CONFIG_TEST=y
CONFIG_TOUCH=y
CONFIG_TRUE=y
CONFIG_TR=y
CONFIG_UNIQ=y
CONFIG_UNAME=y
CONFIG_WC=y
CONFIG_FEATURE_FIND_PRINT0=y
CONFIG_FEATURE_FIND_TYPE=y
