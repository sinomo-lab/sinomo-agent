#ifndef SINOMO_WASIX_UNISTD_EXTENSIONS
#define SINOMO_WASIX_UNISTD_EXTENSIONS 1

#include <fcntl.h>
#include <grp.h>
#include <stddef.h>
#include <sys/time.h>
#include <sys/types.h>
#include <sys/uio.h>
#include <time.h>

struct iovec;
struct statvfs;

int chroot(const char *path);
int close_range(unsigned int first, unsigned int last, int flags);
void closefrom(int lowfd);
ssize_t copy_file_range(int fd_in, off_t *off_in, int fd_out, off_t *off_out, size_t len, unsigned int flags);
char *ctermid_r(char *buf);
int dup3(int oldfd, int newfd, int flags);
int execv(const char *path, char *const argv[]);
int execve(const char *path, char *const argv[], char *const envp[]);
int execveat(int dirfd, const char *path, char *const argv[], char *const envp[], int flags);
int execvp(const char *file, char *const argv[]);
int execvpe(const char *file, char *const argv[], char *const envp[]);
int fchdir(int fd);
int fexecve(int fd, char *const argv[], char *const envp[]);
int fork(void);
int fstatvfs(int fd, struct statvfs *buf);
int futimes(int fd, const struct timeval times[2]);
int futimesat(int dirfd, const char *path, const struct timeval times[2]);
int getgrouplist(const char *user, gid_t group, gid_t *groups, int *ngroups);
int getgroups(int size, gid_t list[]);
int getloadavg(double loadavg[], int nelem);
int getpriority(int which, id_t who);
int getresgid(gid_t *rgid, gid_t *egid, gid_t *sgid);
int getresuid(uid_t *ruid, uid_t *euid, uid_t *suid);
pid_t gettid(void);
int initgroups(const char *user, gid_t group);
int lockf(int fd, int cmd, off_t len);
int lutimes(const char *path, const struct timeval times[2]);
int nice(int inc);
int pause(void);
int pipe2(int fds[2], int flags);
char *ptsname(int fd);
int ptsname_r(int fd, char *buf, size_t buflen);
ssize_t preadv(int fd, const struct iovec *iov, int iovcnt, off_t offset);
ssize_t pwritev(int fd, const struct iovec *iov, int iovcnt, off_t offset);
int setegid(gid_t egid);
int seteuid(uid_t euid);
int setgid(gid_t gid);
int setgroups(size_t size, const gid_t *groups);
int setpriority(int which, id_t who, int priority);
int setregid(gid_t rgid, gid_t egid);
int setresgid(gid_t rgid, gid_t egid, gid_t sgid);
int setresuid(uid_t ruid, uid_t euid, uid_t suid);
int setreuid(uid_t ruid, uid_t euid);
int setuid(uid_t uid);
int sync_file_range(int fd, off_t offset, off_t nbytes, unsigned int flags);
void sync(void);
int unlockpt(int fd);

#endif
