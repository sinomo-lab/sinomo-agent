{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sinomo:dfs:formal-native-trace:v1",
  "title": "Native current PreparedV7 DFS trace envelope v1 - real captures required for conformance",
  "$ref": "#/$defs/TraceEnvelopeV1",
  "$defs": {
    "ShardScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file_system_id": {
          "type": "string",
          "minLength": 1
        },
        "shard_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "file_system_id",
        "shard_id"
      ]
    },
    "OwnerBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_root": {
          "type": "string",
          "minLength": 1
        },
        "root_lease_token": {
          "type": "string",
          "minLength": 1
        },
        "component_incarnation": {
          "type": "string",
          "minLength": 1
        },
        "storage_generation_token": {
          "type": "string",
          "minLength": 1
        },
        "lane_incarnation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "owner_id",
        "node_id",
        "canonical_root",
        "root_lease_token",
        "component_incarnation",
        "storage_generation_token",
        "lane_incarnation"
      ]
    },
    "NativeBlob": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "native_type": {
          "type": "string",
          "minLength": 1
        },
        "encoding": {
          "type": "string",
          "enum": [
            "json-utf8",
            "sobj-base64",
            "exact-frame-base64"
          ]
        },
        "data": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "native_type",
        "encoding",
        "data",
        "sha256"
      ]
    },
    "ConfigTuple": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file_system_id": {
          "type": "string",
          "minLength": 1
        },
        "shard_id": {
          "type": "string",
          "minLength": 1
        },
        "primary_node_id": {
          "type": "string",
          "minLength": 1
        },
        "replica_node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "epoch": {
          "$ref": "#/$defs/DecimalU64"
        },
        "assignment_blob": {
          "type": "string",
          "minLength": 1
        },
        "default_policy_blob": {
          "type": "string",
          "minLength": 1
        },
        "native_config_blob": {
          "type": "string",
          "minLength": 1
        },
        "canonical_fingerprint": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "file_system_id",
        "shard_id",
        "primary_node_id",
        "replica_node_ids",
        "epoch",
        "assignment_blob",
        "default_policy_blob",
        "native_config_blob",
        "canonical_fingerprint"
      ]
    },
    "PrefixProof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "journal_sequence": {
          "$ref": "#/$defs/DecimalU64"
        },
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "native_prefix_blob": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "journal_sequence",
        "digest",
        "native_prefix_blob"
      ]
    },
    "ExactKvRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "entry_blob": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "entry_blob"
      ]
    },
    "ExactKvRead": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExactKvRow"
          }
        },
        "revision": {
          "$ref": "#/$defs/DecimalU64"
        },
        "applied_index": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecimalU64"
            },
            {
              "type": "null"
            }
          ]
        },
        "native_authority_evidence_blob": {
          "type": "string",
          "minLength": 1
        },
        "complete": {
          "type": "boolean"
        },
        "continuous": {
          "type": "boolean"
        }
      },
      "required": [
        "requested_keys",
        "rows",
        "revision",
        "applied_index",
        "native_authority_evidence_blob",
        "complete",
        "continuous"
      ]
    },
    "OperationKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_epoch": {
          "$ref": "#/$defs/DecimalU64"
        },
        "native_digest": {
          "type": "string",
          "minLength": 1
        },
        "payload_blob": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "operation_id",
        "owner_epoch",
        "native_digest",
        "payload_blob"
      ]
    },
    "JournalFrameWitness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "physical_append_ordinal": {
          "$ref": "#/$defs/DecimalU64"
        },
        "sequence": {
          "$ref": "#/$defs/DecimalU64"
        },
        "exact_frame_blob": {
          "type": "string",
          "minLength": 1
        },
        "native_entry_blob": {
          "type": "string",
          "minLength": 1
        },
        "exact_frame_blake3": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "physical_append_ordinal",
        "sequence",
        "exact_frame_blob",
        "native_entry_blob",
        "exact_frame_blake3"
      ]
    },
    "ShardSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/ShardScope"
        },
        "committed_config": {
          "$ref": "#/$defs/ConfigTuple"
        },
        "active_config": {
          "$ref": "#/$defs/ConfigTuple"
        },
        "local_certified_prefix": {
          "$ref": "#/$defs/PrefixProof"
        },
        "durable_journal_prefix": {
          "$ref": "#/$defs/PrefixProof"
        },
        "materialized_through_sequence": {
          "$ref": "#/$defs/DecimalU64"
        },
        "prepare_record_blobs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "commit_record_blobs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "complete_visible_rows_blob": {
          "type": "string",
          "minLength": 1
        },
        "pending_handoff_blob": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "retiring_fence_blob": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "local_marker_blob": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "local_writer_binding_blob": {
          "type": "string",
          "minLength": 1
        },
        "kv_read": {
          "$ref": "#/$defs/ExactKvRead"
        },
        "projection_continuous": {
          "type": "boolean"
        },
        "held_tables_blob": {
          "type": "string",
          "minLength": 1
        },
        "native_operational_facts_blob": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "owner_id",
        "scope",
        "committed_config",
        "active_config",
        "local_certified_prefix",
        "materialized_through_sequence",
        "prepare_record_blobs",
        "commit_record_blobs",
        "complete_visible_rows_blob",
        "pending_handoff_blob",
        "retiring_fence_blob",
        "local_marker_blob",
        "local_writer_binding_blob",
        "kv_read",
        "projection_continuous",
        "held_tables_blob",
        "native_operational_facts_blob"
      ]
    },
    "CaptureTerminal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owners_drained": {
          "type": "boolean"
        },
        "subscriptions_closed": {
          "type": "boolean"
        },
        "dropped_events": {
          "$ref": "#/$defs/DecimalU64"
        },
        "incomplete_events": {
          "$ref": "#/$defs/DecimalU64"
        },
        "discontinuities": {
          "$ref": "#/$defs/DecimalU64"
        },
        "final_owner_sequences": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/DecimalU64"
          }
        }
      },
      "required": [
        "owners_drained",
        "subscriptions_closed",
        "dropped_events",
        "incomplete_events",
        "discontinuities",
        "final_owner_sequences"
      ]
    },
    "EnvironmentObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controlled_online_nodes": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "fault_control_blob": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_response_blobs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "controlled_online_nodes",
        "fault_control_blob",
        "observed_response_blobs"
      ]
    },
    "NativeTraceEventV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_sequence": {
          "allOf": [
            {
              "$ref": "#/$defs/DecimalU64"
            },
            {
              "not": {
                "const": "0"
              }
            }
          ]
        },
        "turn_id": {
          "type": "string",
          "minLength": 1
        },
        "caused_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "before_snapshot": {
          "type": "string",
          "minLength": 1
        },
        "after_snapshot": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "$ref": "#/$defs/NativeActionV1"
        }
      },
      "required": [
        "event_id",
        "owner_id",
        "owner_sequence",
        "turn_id",
        "caused_by",
        "before_snapshot",
        "after_snapshot",
        "action"
      ]
    },
    "TraceEnvelopeV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "projection_version": {
          "const": 1
        },
        "implementation_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "implementation_build_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/ShardScope"
        },
        "owners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OwnerBinding"
          }
        },
        "blobs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/NativeBlob"
          }
        },
        "snapshots": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ShardSnapshot"
          }
        },
        "environment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EnvironmentObservation"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NativeTraceEventV1"
          }
        },
        "terminal": {
          "$ref": "#/$defs/CaptureTerminal"
        },
        "initial_cut": {
          "$ref": "#/$defs/InitialCut"
        },
        "finite_dictionary": {
          "$ref": "#/$defs/FiniteDictionary"
        },
        "metadata_protocol_version": {
          "type": "integer",
          "const": 7,
          "description": "Actual producer binary/native PreparedOperation protocol; current config contains no negotiated codec field."
        }
      },
      "required": [
        "schema_version",
        "projection_version",
        "metadata_protocol_version",
        "implementation_revision",
        "implementation_build_id",
        "schema_sha256",
        "model_sha256",
        "run_id",
        "scope",
        "owners",
        "blobs",
        "snapshots",
        "environment",
        "events",
        "terminal",
        "initial_cut",
        "finite_dictionary"
      ]
    },
    "NativeActionV1": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "prepare-payload"
            },
            "operation": {
              "$ref": "#/$defs/OperationKey"
            },
            "prepare_record_blob": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "type": "string",
              "enum": [
                "applied",
                "journal-durable-materialization-pending",
                "rejected-before-effect",
                "failed-after-effect",
                "ambiguous"
              ]
            }
          },
          "required": [
            "kind",
            "operation",
            "prepare_record_blob",
            "outcome"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "publication-guard-admitted"
            },
            "guard_id": {
              "type": "string",
              "minLength": 1
            },
            "operation": {
              "$ref": "#/$defs/OperationKey"
            },
            "authorization_blob": {
              "type": "string",
              "minLength": 1
            },
            "expected_config": {
              "$ref": "#/$defs/ConfigTuple"
            },
            "outcome": {
              "type": "string",
              "enum": [
                "applied",
                "journal-durable-materialization-pending",
                "rejected-before-effect",
                "failed-after-effect",
                "ambiguous"
              ]
            },
            "retained_configuration_cut": {
              "$ref": "#/$defs/RetainedConfigurationRead"
            }
          },
          "required": [
            "kind",
            "guard_id",
            "operation",
            "authorization_blob",
            "expected_config",
            "retained_configuration_cut",
            "outcome"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "commit-digest"
            },
            "guard_id": {
              "type": "string",
              "minLength": 1
            },
            "operation": {
              "$ref": "#/$defs/OperationKey"
            },
            "supplied_digest": {
              "type": "string",
              "minLength": 1
            },
            "commit_record_blob": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "outcome": {
              "type": "string",
              "enum": [
                "applied",
                "journal-durable-materialization-pending",
                "rejected-before-effect",
                "failed-after-effect",
                "ambiguous"
              ]
            }
          },
          "required": [
            "kind",
            "guard_id",
            "operation",
            "supplied_digest",
            "commit_record_blob",
            "outcome"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "publication-guard-released"
            },
            "guard_id": {
              "type": "string",
              "minLength": 1
            },
            "operation_id": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "type": "string",
              "enum": [
                "applied",
                "journal-durable-materialization-pending",
                "rejected-before-effect",
                "failed-after-effect",
                "ambiguous"
              ]
            }
          },
          "required": [
            "kind",
            "guard_id",
            "operation_id",
            "outcome"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "handoff-begin"
            },
            "handoff_id": {
              "type": "string",
              "minLength": 1
            },
            "retiring": {
              "$ref": "#/$defs/ConfigTuple"
            },
            "desired": {
              "$ref": "#/$defs/ConfigTuple"
            },
            "handoff_blob": {
              "type": "string",
              "minLength": 1
            },
            "pending_begin_local_head": {
              "$ref": "#/$defs/DecimalU64"
            },
            "kv_result_blob": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "type": "string",
              "enum": [
                "applied",
                "journal-durable-materialization-pending",
                "rejected-before-effect",
                "failed-after-effect",
                "ambiguous"
              ]
            },
            "pending_begin_local_prefix": {
              "$ref": "#/$defs/PrefixProof"
            }
          },
          "required": [
            "kind",
            "handoff_id",
            "retiring",
            "desired",
            "handoff_blob",
            "pending_begin_local_head",
            "kv_result_blob",
            "outcome",
            "pending_begin_local_prefix"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "freeze"
            },
            "handoff_id": {
              "type": "string",
              "minLength": 1
            },
            "fenced_prefix": {
              "$ref": "#/$defs/PrefixProof"
            },
            "durable_freeze_blob": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "type": "string",
              "enum": [
                "applied",
                "journal-durable-materialization-pending",
                "rejected-before-effect",
                "failed-after-effect",
                "ambiguous"
              ]
            }
          },
          "required": [
            "kind",
            "handoff_id",
            "fenced_prefix",
            "durable_freeze_blob",
            "outcome"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "handoff-ack"
            },
            "handoff_id": {
              "type": "string",
              "minLength": 1
            },
            "authenticated_source_node": {
              "type": "string",
              "minLength": 1
            },
            "prefix": {
              "$ref": "#/$defs/PrefixProof"
            },
            "durable_promoted_marker_blob": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "verified_response_blob": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "type": "string",
              "enum": [
                "applied",
                "journal-durable-materialization-pending",
                "rejected-before-effect",
                "failed-after-effect",
                "ambiguous"
              ]
            }
          },
          "required": [
            "kind",
            "handoff_id",
            "authenticated_source_node",
            "prefix",
            "durable_promoted_marker_blob",
            "verified_response_blob",
            "outcome"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "activate"
            },
            "handoff_id": {
              "type": "string",
              "minLength": 1
            },
            "completion_proof_blob": {
              "type": "string",
              "minLength": 1
            },
            "kv_result_blob": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "type": "string",
              "enum": [
                "applied",
                "journal-durable-materialization-pending",
                "rejected-before-effect",
                "failed-after-effect",
                "ambiguous"
              ]
            }
          },
          "required": [
            "kind",
            "handoff_id",
            "completion_proof_blob",
            "kv_result_blob",
            "outcome"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "rebind"
            },
            "config": {
              "$ref": "#/$defs/ConfigTuple"
            },
            "current_prefix": {
              "$ref": "#/$defs/PrefixProof"
            },
            "durable_marker_blob": {
              "type": "string",
              "minLength": 1
            },
            "completion_proof_blob": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "type": "string",
              "enum": [
                "applied",
                "journal-durable-materialization-pending",
                "rejected-before-effect",
                "failed-after-effect",
                "ambiguous"
              ]
            },
            "authoritative_exact_read": {
              "$ref": "#/$defs/ExactKvRead"
            }
          },
          "required": [
            "kind",
