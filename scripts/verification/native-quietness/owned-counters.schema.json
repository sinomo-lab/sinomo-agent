{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operator-pinned Sinomo runtime ownership manifest",
  "type": "object",
  "required": ["schema", "purpose", "node_id", "boot_id", "source_revision", "data_dir", "data_identity", "runtime_receipt", "groups", "owners", "delegations"],
  "properties": {
    "schema": {"const": "sinomo.owned-counters.v1"},
    "purpose": {"enum": ["runtime", "isolated-control"]},
    "node_id": {"type": "string", "minLength": 1},
    "boot_id": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "data_dir": {"$ref": "#/$defs/path"},
    "data_identity": {"$ref": "#/$defs/identity"},
    "runtime_receipt": {
      "type": "object", "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}
    },
    "groups": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "required": ["path", "identity"],
        "properties": {"path": {"$ref": "#/$defs/path"}, "identity": {"$ref": "#/$defs/identity"}}
      }
    },
    "owners": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "group", "pid", "start_ticks", "executable", "sha256", "argv", "ownership_ref"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"enum": ["main", "shadow", "helper", "control"]},
          "group": {"type": "string", "minLength": 1},
          "pid": {"type": "integer", "minimum": 1},
          "start_ticks": {"type": "integer", "minimum": 0},
          "executable": {"$ref": "#/$defs/path"},
          "sha256": {"$ref": "#/$defs/hash"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "ownership_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "delegations": {
      "type": "array",
      "items": {
        "type": "object", "required": ["operation_id", "owner_id", "ownership_ref"],
        "properties": {
          "operation_id": {"type": "string", "minLength": 1},
          "owner_id": {"type": "string", "minLength": 1},
          "ownership_ref": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^/", "minLength": 2},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}}
  },
  "$comment": "Collector additionally enforces disjoint roots, unique owner IDs/PIDs, live pidfds, kernel/file identities, receipt digest and matching bindings; runtime purpose needs exactly one main/shadow and no control role. Unknown extra fields never grant coverage. Receipt provenance and completeness require independent qualification."
}
