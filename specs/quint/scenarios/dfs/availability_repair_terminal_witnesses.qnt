/// Explicit main for NEW C5/C6 targets only. Guard rejection uses shared
/// read-only predicates + stutter; positive paths execute actual model actions.
module dfs_repair_terminal_witnesses {
  import dfs_repair_terminal_contract.* from "../../contracts/dfs/availability_repair_terminal"
  import dfs_repair_terminal.* from "../../models/dfs/availability_repair_terminal"
  import dfs_repair_terminal_target.* from "../../checks/dfs/availability_repair_terminal_target"
  run preparedPrefix = init.expect(safety).then(appendPrepared(1, 101)).expect(safety)
    .then(syncPrepared(1)).expect(safety)
  run contentPrefix = preparedPrefix.then(appendContent(1)).expect(safety).then(syncContent(1)).expect(safety)
  run authContentPrefix = initAuthoritative.expect(safety).then(appendPrepared(1, 101))
    .then(syncPrepared(1)).then(appendContent(1)).then(syncContent(1)).expect(safety)
  run firstRolePrefix = authContentPrefix.then(prepareRole(1, 1)).then(appendRoleCommit(1, 1))
    .then(certifyRoleCommit(1, 1)).expect(safety)
  run allRolesPrefix = firstRolePrefix.then(prepareRole(1, 2)).then(appendRoleCommit(1, 2))
    .then(certifyRoleCommit(1, 2)).expect(safety)
  run terminalPrefix = contentPrefix.then(appendTerminal(1, 201)).expect(safety).then(syncTerminal(1)).expect(safety)
  run savedPrefix = terminalPrefix.then(historicalReply(1, 101, 201)).expect(safety)
    .then(observeReply(1)).then(saveReply(1)).expect(safety)
  run appliedPrefix = savedPrefix.then(assumeCausalProof).then(applyCurrent).expect(safety)
  run transferPrefix = init.then(installHead).then(assumeRecoveryPromise).then(retireResponsibility)
    .then(dischargeForwardBody).expect(safety)
  run threeHoldersPrefix = transferPrefix.then(qualifyBHold).expect(safety)
  run rootProofPrefix = threeHoldersPrefix.then(reserveRoot(1, TransferRoute)).expect(safety)
    .then(persistRootProof(1)).expect(safety)

  run effectsNeedPreparedSyncTest = init.then(appendPrepared(1, 101))
    .then(all { not(mayContent(1)), s' = s }).expect(all { safety, s.contentWrites == 0 })
  run crashAfterPreparedAppendTest = init.then(appendPrepared(1, 101)).then(crashReceiver(true)).then(recertifyReceiver)
    .then(all { not(mayContent(1)), not(mayReply(1, 101, 201)), s' = s })
    .expect(all { safety, s.pSync == Set(), s.unresolved == Set(1), holders(1) == Set(1, 3) })
  run crashAfterPreparedSyncTest = preparedPrefix.then(crashReceiver(true))
    .then(all { not(mayContent(1)), s' = s }).then(recertifyReceiver)
    .then(appendContent(1)).expect(all { safety, s.contentWrites == 1, s.tSync == Set() })
  run crashAfterContentAppendTest = preparedPrefix.then(appendContent(1)).then(crashReceiver(false)).then(recertifyReceiver)
    .then(all { not(mayTerminal(1, 201)), s' = s })
    .expect(all { safety, s.cRead == Set(1), s.cSync == Set(), s.unresolved == Set(1) })
  run crashAfterContentSyncBeforeMetadataTest = authContentPrefix.then(crashReceiver(true)).then(recertifyReceiver)
    .then(all { not(mayTerminal(1, 201)), s' = s }).expect(all { safety, s.mSync == Set() })
  run crashAfterOneRequiredRoleTest = firstRolePrefix.then(crashReceiver(true)).then(recertifyReceiver)
    .then(all { not(mayTerminal(1, 201)), s' = s }).expect(all { safety, s.mSync == Set((1, 1)) })
  run crashAfterRolePrepareBeforeCommitTest = authContentPrefix.then(prepareRole(1, 1))
    .then(crashReceiver(true)).then(recertifyReceiver)
    .then(all { not(mayTerminal(1, 201)), not(mayReply(1, 101, 201)), s' = s })
    .expect(all { safety, s.mPrepared == Set((1, 1)), s.mSync == Set(), s.metadataWrites == 0 })
  run crashAfterRoleCommitBeforeCertificationTest = authContentPrefix.then(prepareRole(1, 1)).then(appendRoleCommit(1, 1))
    .then(crashReceiver(false)).then(recertifyReceiver)
    .then(all { not(mayTerminal(1, 201)), not(mayReply(1, 101, 201)), s' = s })
    .expect(all { safety, s.mRead == Set((1, 1)), s.mSync == Set(), s.mCert == Set() })
  run crashAfterAllRolesBeforeTerminalTest = allRolesPrefix.then(crashReceiver(true)).then(recertifyReceiver)
    .then(all { not(mayReply(1, 101, 201)), s' = s }).then(appendTerminal(1, 201)).then(syncTerminal(1))
    .expect(all { safety, s.metadataWrites == 2, s.tSync == Set(1) })
  run crashAfterTerminalAppendBeforeSyncTest = contentPrefix.then(appendTerminal(1, 201))
    .then(crashReceiver(false)).then(recertifyReceiver)
    .then(all { not(mayReply(1, 101, 201)), s' = s }).expect(all { safety, s.tRead == Set(1), s.tSync == Set() })
    .then(syncTerminal(1)).then(historicalReply(1, 101, 201)).expect(safety)
  run crashAfterTerminalSyncBeforeReplyTest = terminalPrefix.then(crashReceiver(true))
    .then(all { not(mayReply(1, 101, 201)), s' = s }).then(recertifyReceiver)
    .then(historicalReply(1, 101, 201)).expect(all { safety, s.contentWrites == 1, s.metadataWrites == 0,
      s.result.get(1) == 201, s.pBody.get(1) == 101, s.unresolved == Set(1) })
  run exactLostReplyReplayHasNoEffectTest = terminalPrefix.then(historicalReply(1, 101, 201))
    .then(historicalReply(1, 101, 201)).then(historicalReply(1, 101, 201))
    .expect(all { safety, s.replies == 3, s.contentWrites == 1, s.metadataWrites == 0,
      s.cacheWrites == 0, s.receiptWrites == 0, s.headWrites == 0, s.saved == Set() })
  run sameIdentityChangedMaterialRejectsTest = terminalPrefix
    .then(all { not(mayPrepare(1, 999)), not(mayReply(1, 999, 201)), not(mayReply(1, 101, 999)), s' = s })
    .expect(all { safety, s.pBody.get(1) == 101, s.result.get(1) == 201, s.contentWrites == 1 })
  run historicalDescriptorCannotPublishTest = savedPrefix.then(historicalReply(1, 101, 201))
    .expect(all { safety, not(s.currentCopy), not(s.currentHead), s.cacheWrites == 0, s.receiptWrites == 0, s.headWrites == 0 })
  run stalePositiveAfterWithdrawalRejectsTest = savedPrefix.then(assumeCausalProof).then(withdraw)
    .then(historicalReply(1, 101, 201)).then(all { not(mayApply), not(mayCausalProof), s' = s })
    .expect(all { safety, s.withdrawn, s.deficit, not(s.currentCopy), not(s.currentHead) })
  run historicalApplicationSurvivesWithdrawalTest = appliedPrefix.then(withdraw).then(historicalReply(1, 101, 201))
    .expect(all { safety, s.applied == Set(1), not(s.currentCopy), s.deficit, s.receiptWrites == 1 })
  run servingEpochPreservesPhysicalHistoryTest = savedPrefix.then(servingRebind).then(historicalReply(1, 101, 201))
    .expect(all { safety, s.epoch == 2, s.stores.get(3) == 1, holders(1) == Set(1, 3), s.tStore.get(1) == 1 })
  run physicalReplacementNeedsRetainedHistoryTest = savedPrefix.then(crashSource).then(replaceStore(3))
    .then(all { not(mayReply(1, 101, 201)), s' = s }).then(recertifySource)
    .then(historicalReply(1, 101, 201)).then(all { not(mayCausalProof), not(mayPrepare(1, 101)), s' = s })
    .expect(all { safety, s.stores.get(3) == 2, s.savedStore.get(1) == 1, s.tSync == Set(), holders(1) == Set(1) })
  run replacementWithoutSavedTerminalStaysPendingTest = terminalPrefix.then(replaceStore(3))
    .then(all { not(mayReply(1, 101, 201)), not(mayPrepare(1, 101)), s' = s })
    .expect(all { safety, s.unresolved == Set(1), s.saved == Set(), s.result.get(1) == 0 })
  run sourceRetainedCannotEnableSuccessorTest = initSourceOnly.then(installHead)
    .then(all { not(successorPayloadReady), s' = s }).expect(all { safety, holders(1) == Set(1) })
  run headAndCHoldCannotReleaseATest = transferPrefix
    .then(all { not(mayReserve(1, TransferRoute)), s' = s })
    .expect(all { safety, s.installedHead, s.responsibilityRetired, postHolders(1) == Set(3), s.released == Set() })
  run separateBCHoldsPermitRootReleaseTest = rootProofPrefix.then(qualifyBHold).then(releaseRoot(1))
    .expect(all { safety, holders(1) == Set(2, 3), s.released == Set((1, 1)), s.unresolved == Set(1) })
  run dependencyChangeRejectsOldProofTest = rootProofPrefix.then(borrowBody)
    .then(all { not(mayRelease(1)), s' = s }).then(returnBody).then(reserveRoot(1, TransferRoute))
    .then(all { not(mayRelease(1)), s' = s }).then(persistRootProof(1)).then(releaseRoot(1))
    .expect(all { safety, s.dep == 3, holders(1) == Set(2, 3) })
  run childKeepsItsOwnPhysicalRootTest = rootProofPrefix.then(enrollChild)
    .then(all { not(mayRelease(1)), s' = s }).then(reserveRoot(1, TransferRoute)).then(persistRootProof(1)).then(releaseRoot(1))
    .expect(all { safety, s.child, holders(2) == Set(1), s.unresolved == Set(1, 2), holders(1) == Set(2, 3) })
  run borrowerBlocksRootRetirementTest = threeHoldersPrefix.then(borrowBody)
    .then(all { not(mayReserve(1, TransferRoute)), s' = s }).expect(all { safety, holders(1).contains(1) })
    .then(returnBody).then(reserveRoot(1, TransferRoute)).then(persistRootProof(1)).then(releaseRoot(1))
    .then(all { not(mayBorrowBody), s' = s }).expect(safety)
  run responsibilityKeepsForwardingAndFutureTest = init.then(installHead).then(assumeRecoveryPromise).then(retireResponsibility)
    .then(lateFact).then(lateFact).expect(all { safety, s.lateFacts == 2, s.forwardStub, s.forwardBody, s.released == Set() })
  run exactSettlementAllowsRootReleaseTest = appliedPrefix.then(dischargeForwardBody).then(qualifyBHold).then(settleOriginal)
    .then(reserveRoot(2, SettlementRoute)).then(persistRootProof(2)).then(releaseRoot(2))
    .then(all { not(mayQualifyB), s' = s }).expect(all { safety, noResurrection })
    .then(reserveRoot(1, SettlementRoute)).then(persistRootProof(1)).then(releaseRoot(1))
    .then(historicalReply(1, 101, 201)).then(lateFact)
    .expect(all { safety, s.unresolved == Set(), holders(1) == Set(3), s.saved == Set(1), s.forwardStub })
  run observedTerminalCannotSettleTest = terminalPrefix.then(historicalReply(1, 101, 201)).then(observeReply(1))
    .then(all { not(mayDischargeForwardBody), not(settlementReady), not(mayReserve(1, SettlementRoute)), s' = s })
    .then(crashSource).expect(all { safety, s.saved == Set(), s.observed == Set(), s.unresolved == Set(1) })
  run pendingOriginalDoesNotBlockOtherTest = preparedPrefix.then(sealSecondOriginal)
    .then(appendPrepared(2, 102)).then(syncPrepared(2)).then(appendContent(2)).then(syncContent(2))
    .then(appendTerminal(2, 202)).then(syncTerminal(2)).then(historicalReply(2, 102, 202))
    .expect(all { safety, not(s.tSync.contains(1)), s.tSync.contains(2), s.pBody.get(1) == 101, s.unresolved == Set(1, 2) })
  run conflictingRetirementReservationRejectsTest = rootProofPrefix
    .then(all { not(mayReserve(3, TransferRoute)), s' = s }).then(releaseRoot(1))
    .then(all { not(mayReserve(3, TransferRoute)), not(mayReplace(3)), s' = s })
    .expect(all { safety, holders(1) == Set(2, 3), s.reservations == Set() })
  run holderReplacementInvalidatesRootProofTest = rootProofPrefix.then(replaceStore(3))
    .then(all { not(mayRelease(1)), not(mayReserve(1, TransferRoute)), s' = s })
    .expect(all { safety, holders(1) == Set(1, 2), s.reservations == Set(), s.proofCoverage.get(1) < s.coverageRev })
  run oldPhysicalRootProofRejectsNewStoreTest = rootProofPrefix.then(replaceStore(1))
    .then(all { not(mayRelease(1)), not(mayReplayRelease(1)), not(mayEnrollChild), s' = s })
    .expect(all { safety, s.proofStore.get(1) == 1, s.stores.get(1) == 2, holders(1) == Set(2, 3) })
  run durableRootProofAndReleaseReplayTest = rootProofPrefix.then(crashSource)
    .then(all { not(mayRelease(1)), s' = s }).then(recertifySource).then(releaseRoot(1)).then(releaseRoot(1))
    .expect(all { safety, s.released == Set((1, 1)), holders(1) == Set(2, 3), s.forwardStub })
  run durableSettlementSurvivesLaterSourceCrashTest = appliedPrefix.then(dischargeForwardBody)
    .then(installHead).then(assumeRecoveryPromise).then(retireResponsibility).then(qualifyBHold)
    .then(reserveRoot(1, TransferRoute)).then(persistRootProof(1)).then(releaseRoot(1)).then(settleOriginal)
    .then(reserveRoot(2, SettlementRoute)).then(persistRootProof(2)).then(releaseRoot(2)).then(crashSource)
    .then(all { not(settlementReady), not(mayReserve(3, SettlementRoute)), s' = s })
    .expect(all { safety, s.settled == Set(1), holders(1) == Set(3), s.saved == Set(1), s.savedCert == Set() })

  // Mutants are scenario-only and use the actual precondition/effect comparison
  // to derive sticky audits; no mutant action belongs to the target protocol.
  action brokenEffectBeforePrepared = s' = contentCandidate(1).with("effectAudit", s.effectAudit and exactPrepared(1))
  def forcedTerminal: State = terminalCandidate(1, 201).with("tSync", s.tSync.union(Set(1))).with("tCert", s.tCert.union(Set(1)))
  action brokenTerminal = s' = forcedTerminal.with("terminalAudit", s.terminalAudit and mayTerminal(1, 201))
  action brokenEarlyReply = s' = replyCandidate(1).with("replyAudit", s.replyAudit and mayReply(1, 101, 201))
  def mutatedReplay: State = replyCandidate(1).with("contentWrites", s.contentWrites + 1)
  action brokenReplayEffect = s' = mutatedReplay.with("replayAudit", s.replayAudit and noEffects(s, mutatedReplay))
  action brokenOldPositive = s' = applicationCandidate.with("applicationAudit", s.applicationAudit and mayApply)
  action brokenEpochPhysical = s' = s.with("epoch", 2).with("stores", s.stores.set(3, 2))
  action brokenAckRelease = s' = releaseCandidate(1).with("transferReleased", true)
    .with("releaseAudit", s.releaseAudit and mayRelease(1))
  action brokenStaleRelease = s' = releaseCandidate(1).with("releaseAudit", s.releaseAudit and mayRelease(1))
  action brokenBothProofs = s' = s.with("rootProofs", Set(1, 3)).with("rootProofCert", Set(1, 3)).with("reservations", Set(1, 3))
    .with("proofStore", s.proofStore.set(3, s.stores.get(3))).with("proofDep", s.proofDep.set(3, s.dep))
    .with("proofCoverage", s.proofCoverage.set(3, s.coverageRev)).with("proofRoute", s.proofRoute.set(3, TransferRoute))
  action brokenConsumeA = s' = releaseCandidate(1).with("releaseAudit", s.releaseAudit and mayRelease(1))
  action brokenConsumeC = s' = releaseCandidate(3).with("releaseAudit", s.releaseAudit and mayRelease(3))

  run preparedSyncSensitivityTest = init.then(brokenEffectBeforePrepared).expect(not(preparedSafety))
  run synthesizedTerminalSensitivityTest = init.then(brokenTerminal).expect(not(terminalSafety))
  run missingMetadataRoleSensitivityTest = firstRolePrefix.then(brokenTerminal).expect(not(terminalSafety))
  run earlyReplySensitivityTest = contentPrefix.then(appendTerminal(1, 201)).then(brokenEarlyReply).expect(not(replySafety))
  run historicalEffectSensitivityTest = savedPrefix.then(brokenReplayEffect).expect(not(replySafety))
  run withdrawnPositiveSensitivityTest = appliedPrefix.then(withdraw).then(brokenOldPositive).expect(not(applicationSafety))
  run epochPhysicalSensitivityTest = preparedPrefix.then(brokenEpochPhysical).expect(not(physicalSafety))
  run insufficientPostReleaseSensitivityTest = transferPrefix.then(brokenAckRelease)
    .expect(all { not(retirementSafety), holders(1) == Set(3) })
  run staleDependencySensitivityTest = rootProofPrefix.then(borrowBody).then(brokenStaleRelease)
    .expect(all { not(retirementSafety), s.proofDep.get(1) < s.dep })
  run concurrentReleaseSensitivityTest = rootProofPrefix.then(brokenBothProofs).then(brokenConsumeA).then(brokenConsumeC)
    .expect(all { not(retirementSafety), holders(1) == Set(2), s.released == Set((1, 1), (3, 1)) })

  run unsafePreparedSyncCounterexample = init.then(brokenEffectBeforePrepared).expect(safety)
  run unsafeSynthesizedTerminalCounterexample = init.then(brokenTerminal).expect(safety)
  run unsafeMissingMetadataRoleCounterexample = firstRolePrefix.then(brokenTerminal).expect(safety)
  run unsafeEarlyReplyCounterexample = contentPrefix.then(appendTerminal(1, 201)).then(brokenEarlyReply).expect(safety)
  run unsafeHistoricalEffectCounterexample = savedPrefix.then(brokenReplayEffect).expect(safety)
  run unsafeWithdrawnPositiveCounterexample = appliedPrefix.then(withdraw).then(brokenOldPositive).expect(safety)
  run unsafeEpochPhysicalCounterexample = preparedPrefix.then(brokenEpochPhysical).expect(safety)
  run unsafeInsufficientPostReleaseCounterexample = transferPrefix.then(brokenAckRelease).expect(safety)
  run unsafeStaleDependencyCounterexample = rootProofPrefix.then(borrowBody).then(brokenStaleRelease).expect(safety)
  run unsafeConcurrentReleaseCounterexample = rootProofPrefix.then(brokenBothProofs).then(brokenConsumeA).then(brokenConsumeC).expect(safety)
}
